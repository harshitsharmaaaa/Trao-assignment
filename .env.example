# MongoDB Database Connection String (Server-only, Required in Production)
MONGODB_URI=

# JWT Session Secret Key (Server-only, Required)
JWT_SECRET=

# Google Gemini API Keys — 4 independent project quota pools (Server-only, Required when MOCK_LLM=false)
# Slot 1 is the pre-existing project key. Slots 2-4 are additional projects.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# LLM Provider & Model Selection (Server-only)
LLM_PROVIDER=
LLM_MODEL=
MOCK_LLM=

# Allow Localhost URLs for batch evaluation (Server-only, Set false in production)
ALLOW_LOCAL_URLS=

# Max Gemini generation HTTP attempts per rolling 60s window, per process
# (every attempt including retries counts; observed free-tier: 5)
LLM_REQUESTS_PER_MINUTE=5
